# ============================================================
# frontend/.env.example
# 复制为 frontend/.env 后再修改：cp frontend/.env.example frontend/.env
# 浏览器最终请求的是宿主机暴露的 8000 端口，因此这里写 localhost。
# ============================================================

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:8000/api/auth
