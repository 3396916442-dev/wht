# ============================================================
# backend/.env.example
# 复制为 backend/.env 后再修改：cp backend/.env.example backend/.env
# 该文件中的默认值与 docker-compose.yml 中 mysql / redis 服务保持一致，
# 直接配合 `docker compose up -d` 即可使用，无需额外改动。
# ============================================================

# 应用
PROJECT_NAME=quant-platform
VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO

# MySQL（与 docker-compose 中 mysql 服务一致）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=quant_user
MYSQL_PASSWORD=quant_password
MYSQL_DATABASE=quant_platform
MYSQL_POOL_SIZE=10
MYSQL_POOL_RECYCLE=3600

# Redis（与 docker-compose 中 redis 服务一致）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 数据源（首发 akshare，后期 tushare）
DATA_SOURCE=akshare
AKSHARE_TIMEOUT=30
# 默认 false：绕过 macOS 系统代理，避免 Clash 未启动时 ProxyError
AKSHARE_USE_SYSTEM_PROXY=false
# 若访问东方财富必须走代理，填写例如 http://127.0.0.1:7890（留空则直连）
AKSHARE_HTTP_PROXY=
TUSHARE_TOKEN=

# 调度器（APScheduler）
# SCHEDULER_ENABLED=false 时不启动定时任务（适合纯 API 调试 / 单测）
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_DAILY_SYNC_HOUR=16
SCHEDULER_DAILY_SYNC_MINUTE=30

# 默认监控股票池（CSV，不带前缀；空格会被自动忽略）
WATCH_STOCKS=600519,000001,300750

# CORS（前端开发地址）
CORS_ORIGINS=["http://localhost:3000"]

# JWT 认证（生产环境务必更换 JWT_SECRET_KEY）
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# QQ 邮箱 SMTP（用于注册验证码，需在 QQ 邮箱开启 SMTP 并获取授权码）
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_EMAIL=your_qq_email@qq.com
QQ_EMAIL_AUTH_CODE=your_qq_email_auth_code
EMAIL_CODE_EXPIRE_SECONDS=300
EMAIL_CODE_RESEND_COOLDOWN=60

# 开发环境默认超级管理员（生产环境务必修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_strong_password
ADMIN_EMAIL=admin@qq.com
